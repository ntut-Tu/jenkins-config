name: {{ s.project.name | scalar }}
services:
  controller:
    image: {{ s.images.controller | scalar }}
    restart: unless-stopped
    ports: [{{ ("127.0.0.1:" ~ s.jenkins.http_port ~ ":8080") | scalar }}]
    environment:
      CASC_JENKINS_CONFIG: /etc/jenkins/casc
      SECRETS: /run/secrets
      JAVA_OPTS: -Djenkins.install.runSetupWizard=false
    volumes:
      - jenkins-home:/var/jenkins_home
      - type: bind
        source: {{ (state ~ "/casc") | compose_scalar }}
        target: /etc/jenkins/casc
        read_only: true
    secrets:
      - admin_password
{% if s.credentials.pipeline_git.enabled %}
      - git_username
      - git_token
{% endif %}
{% if s.credentials.application_git.enabled %}
      - application_git_username
      - application_git_token
{% endif %}
    healthcheck:
      test: [CMD, curl, -fsS, 'http://localhost:8080/login']
      interval: 5s
      timeout: 5s
      retries: 60
      start_period: 30s
  agent:
    image: {{ s.images.agent | scalar }}
    restart: unless-stopped
    environment:
      TESTCONTAINERS_HOST_OVERRIDE: host.docker.internal
    extra_hosts: ['host.docker.internal:host-gateway']
    depends_on:
      controller: {condition: service_healthy}
    command: [-url, 'http://controller:8080/', -name, docker-agent, -secret, '@/run/secrets/agent_secret', -webSocket, -workDir, /home/jenkins/agent]
    secrets: [agent_secret]
    group_add: [{{ (s.docker.socket_gid | string) | scalar }}]
    volumes:
      - agent-work:/home/jenkins/agent
      - type: bind
        source: {{ s.docker.socket | compose_scalar }}
        target: /var/run/docker.sock
        bind: {create_host_path: false}
volumes:
  jenkins-home: {}
  agent-work: {}
secrets:
  admin_password:
    file: {{ (secrets ~ "/admin_password") | compose_scalar }}
  agent_secret:
    file: {{ (state ~ "/agent_secret") | compose_scalar }}
{% if s.credentials.pipeline_git.enabled %}
  git_username:
    file: {{ (secrets ~ "/git_username") | compose_scalar }}
  git_token:
    file: {{ (secrets ~ "/git_token") | compose_scalar }}
{% endif %}
{% if s.credentials.application_git.enabled %}
  application_git_username:
    file: {{ (secrets ~ "/application_git_username") | compose_scalar }}
  application_git_token:
    file: {{ (secrets ~ "/application_git_token") | compose_scalar }}
{% endif %}
