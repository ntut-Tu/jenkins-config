jenkins:
  systemMessage: "PDD Jenkins — managed by jenkins-config"
  numExecutors: 0
  mode: EXCLUSIVE
  disableRememberMe: true
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: {{ s.jenkins.admin.user | scalar }}
          password: "${admin_password}"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  crumbIssuer:
    standard: {}
  nodes:
    - permanent:
        name: docker-agent
        remoteFS: /home/jenkins/agent
        numExecutors: 1
        labelString: pdd-test
        mode: EXCLUSIVE
        launcher:
          inbound:
            workDirSettings:
              disabled: false
              internalDir: remoting
              failIfWorkDirIsMissing: false
        retentionStrategy: always
security:
  queueItemAuthenticator:
    authenticators:
      - project:
          enabledStrategies:
            - org.jenkinsci.plugins.authorizeproject.strategy.SpecificUsersAuthorizationStrategy
          disabledStrategies:
            - org.jenkinsci.plugins.authorizeproject.strategy.AnonymousAuthorizationStrategy
            - org.jenkinsci.plugins.authorizeproject.strategy.TriggeringUsersAuthorizationStrategy
            - org.jenkinsci.plugins.authorizeproject.strategy.SystemAuthorizationStrategy
unclassified:
  location:
    url: {{ s.jenkins.url | scalar }}
{% if s.gitlab.enabled %}
  gitlabconnectionconfig:
    # Webhooks authenticate with the per-job secret token; other /project calls need a Jenkins API token.
    useAuthenticatedEndpoint: true
    connections:
      - name: gitlab
        url: {{ s.gitlab.url | scalar }}
        apiTokenId: gitlab-api
        clientBuilderId: autodetect
        ignoreCertificateErrors: false
        connectionTimeout: 10
        readTimeout: 10
{% endif %}
{% if s.credentials.pipeline_git.enabled or s.credentials.application_git.enabled or s.credentials.github_api.enabled or s.gitlab.enabled %}
credentials:
  system:
    domainCredentials:
      - credentials:
{% if s.credentials.pipeline_git.enabled %}
          - usernamePassword:
              scope: GLOBAL
              id: pipeline-git
              username: "${git_username}"
              password: "${git_token}"
              description: Read-only access to the trusted pipelines repository
{% endif %}
{% if s.credentials.application_git.enabled %}
          - usernamePassword:
              scope: GLOBAL
              id: application-git
              username: "${application_git_username}"
              password: "${application_git_token}"
              description: Read-only access to the application repository under test
{% endif %}
{% if s.credentials.github_api.enabled %}
          - string:
              scope: GLOBAL
              id: github-api
              secret: "${github_api_token}"
              description: Read-only GitHub API access for PR polling
{% endif %}
{% if s.gitlab.enabled %}
          - gitLabApiTokenImpl:
              scope: SYSTEM
              id: gitlab-api
              apiToken: "${gitlab_api_token}"
              description: GitLab API access for merge request commit statuses
          - usernamePassword:
              scope: GLOBAL
              id: gitlab-git
              username: {{ s.gitlab.git_username | scalar }}
              password: "${gitlab_api_token}"
              description: Git checkout of GitLab projects with the same GitLab token
          - string:
              scope: GLOBAL
              id: gitlab-webhook-secret
              secret: "${gitlab_webhook_secret}"
              description: Secret token GitLab sends with merge request webhooks
{% endif %}
{% endif %}
jobs:
  - script: |
{% filter indent(6, true) %}{% include 'seed-job.groovy.j2' %}{% endfilter %}